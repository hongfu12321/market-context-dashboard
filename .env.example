# --- Alpaca Market Data (optional; without keys the app runs on clearly-labelled MOCK data) ---
# Create keys at https://app.alpaca.markets (Paper account is fine; market data works with paper keys).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex          = free real-time IEX feed (default; IEX-only volume, not consolidated)
# sip          = consolidated feed (requires paid Algo Trader Plus subscription)
# delayed_sip  = consolidated but 15-minute delayed (always labelled DELAYED in the UI)
ALPACA_DATA_FEED=iex

# --- Anthropic (optional; without a key the chat returns a deterministic summary) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
